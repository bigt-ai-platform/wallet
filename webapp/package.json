{
  "name": "wallet-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Android app wrapping the wallet web export (Capacitor).",
  "scripts": {
    "build:web": "cd ../expo-app && expo export --platform web --output-dir dist",
    "add:android": "cap add android && node scripts/patch-android.mjs",
    "sync": "cap sync android && node scripts/patch-android.mjs",
    "build:android": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "capacitor-secure-storage-plugin": "^0.13.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}

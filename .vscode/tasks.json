{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kill Expo Processes",
      "type": "shell",
      "command": "pkill -f 'npx expo start' 2>/dev/null || true; lsof -ti:8081 | xargs kill -9 2>/dev/null || true; sleep 1",
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      }
    },
    {
      "label": "Start Expo Web",
      "type": "shell",
      "command": "npx expo start --web --port 8081 --offline",
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting.*",
          "endsPattern": ".*Web is waiting.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "expo"
      },
      "dependsOn": ["Kill Expo Processes"]
    },
    {
      "label": "Start Expo Dev Server",
      "type": "shell",
      "command": "yarn",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting.*",
          "endsPattern": ".*Metro.*waiting.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "expo"
      }
    },
    {
      "label": "Start Expo iOS",
      "type": "shell",
      "command": "yarn",
      "args": ["ios"],
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "expo"
      }
    },
    {
      "label": "Start Expo Android",
      "type": "shell",
      "command": "yarn",
      "args": ["android"],
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "expo"
      }
    },
    {
      "label": "TypeCheck",
      "type": "shell",
      "command": "yarn",
      "args": ["typecheck"],
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "build"
      }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "yarn",
      "args": ["test"],
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "group": "test"
      }
    },
    {
      "label": "Prebuild (Generate Native Projects)",
      "type": "shell",
      "command": "yarn",
      "args": ["prebuild"],
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "build"
      }
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "rm -rf node_modules .expo android ios && yarn install",
      "options": {
        "cwd": "${workspaceFolder}/expo-app"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "build"
      }
    }
  ]
}

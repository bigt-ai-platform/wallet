# P2P settlement engine runtime image (docs/p2p.md).
#
# Build from the repo root so the workspace packages are in scope:
#   docker build -f deploy/Dockerfile.p2p-engine -t wallet-p2p-engine:latest .
#
# The engine depends on the workspace packages `bigtangle-ts`, `chain-discovery`,
# `did`, `record-sig`, `p2p-protocol`, `mobile-control` and `p2p-verify` (built in
# dependency order below — `chain-discovery` has no workspace deps and must
# precede the engine). `services/p2p-verify` (a workspace service) and its
# `mobile-control` dep must be in the build context: the engine dynamic-imports
# `p2p-verify` (server.ts) and esbuild bundles it.
FROM node:20-slim AS build
WORKDIR /app
ENV NODE_ENV=development

COPY package.json yarn.lock ./
COPY packages ./packages
COPY services/p2p-engine ./services/p2p-engine
COPY services/p2p-verify ./services/p2p-verify

# The engine's workspace deps are the packages above; a full-workspace install
# (expo/webapp) is neither available nor wanted in this image.
RUN yarn install --frozen-lockfile --ignore-scripts --ignore-engines \
    --production=false 2>/dev/null || yarn install --ignore-scripts --ignore-engines

RUN yarn workspace chain-discovery build \
 && yarn workspace bigtangle-ts build \
 && yarn workspace p2p-protocol build \
 && yarn workspace mobile-control build \
 && yarn workspace did build \
 && yarn workspace record-sig build \
 && yarn workspace p2p-verify build \
 && yarn workspace p2p-engine build \
 && yarn workspace p2p-engine bundle

# The bundle inlines everything except three packages it keeps external:
#   - pg: dynamic import in main()
#   - ajv + ajv-formats: the runtime modules fastify's compiled validators
#     `require` (they cannot be bundled into the generated validator code)
# Record the exact resolved versions so the runtime install cannot drift from
# the versions the bundle/validators were built against.
RUN node -e 'const fs=require("fs");const v=(n)=>require(`/app/node_modules/${n}/package.json`).version;fs.writeFileSync("/runtime-deps.json",JSON.stringify({pg:v("pg"),ajv:v("ajv"),"ajv-formats":v("ajv-formats")}))'

# Runtime: only the esbuild bundle + its external deps. No workspace sources,
# no dev toolchain (typescript/vite/tsx/esbuild/vitest/… used to add ~150 MB).
FROM node:20-slim AS runtime
WORKDIR /app/services/p2p-engine
ENV NODE_ENV=production
COPY --from=build /runtime-deps.json /tmp/runtime-deps.json
COPY --from=build /app/services/p2p-engine/dist ./dist
RUN npm install --no-save --omit=dev --no-audit --no-fund --ignore-scripts \
      $(node -p 'Object.entries(require("/tmp/runtime-deps.json")).map(([k,v])=>k+"@"+v).join(" ")') \
 && npm cache clean --force \
 && rm -f /tmp/runtime-deps.json
EXPOSE 8108
# Runs the esbuild bundle: bigtangle-ts ships extensionless ESM + CJS-interop
# deps that plain `node dist/server.js` cannot load under Node's ESM resolver.
CMD ["node", "dist/server.bundle.mjs"]

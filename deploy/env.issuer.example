# Asset issuer (services/asset-issuer) secrets — TEMPLATE, never commit secrets.
#
#   cp deploy/env.issuer.example deploy/env/.env.issuer.europa
#   chmod 600 deploy/env/.env.issuer.europa
#   $EDITOR deploy/env/.env.issuer.europa          # fill the <placeholders>
#   ./deploy/region.sh issuer europa               # or: ./deploy/deploy.sh
#
# region.sh scps this file to <VM>:<repo>/deploy/env/.env.issuer.<region> and
# compose reads it with --env-file. Shell environment wins over this file, so a
# one-off override does not need an edit. The file lives under the gitignored
# deploy/env/ — the release train stops shipping the stack (with a warning) if
# it is missing, rather than starting an unauthenticated Mainnet issuer.
#
# The issuer is a SINGLETON (region.conf ASSET_ISSUER_REGION): one xpub + one
# reserve ledger for every region. Do not run it on a second VM.

# ─── Postgres (REQUIRED) ───
# Own database, never the p2p engine's or a chain node's. Used for the reserve
# ledger, holder balances and the idempotency keys that prevent a double mint.
ASSET_ISSUER_DB_PASSWORD=<long-random-secret>

# Test until the reserve accounts + attestations are live. On Mainnet the
# service refuses AUTH_MODE=off and refuses to start without Postgres.
NETWORK=Test

# ─── Auth (default-deny outside Test) ───
# bearer = shared API_TOKEN; hmac = account-bound x-account/x-timestamp/
# x-signature. The web build sends EXPO_PUBLIC_ISSUER_API_TOKEN as a bearer, so
# a shipped token is public — use hmac when the client can sign.
AUTH_MODE=off
API_TOKEN=
API_HMAC_SECRET=
AUTH_MAX_SKEW_MS=300000

# ─── Assets ───
# JSON override of DEFAULT_ASSETS (services/asset-issuer/src/config.ts must
# match expo-app/sources/lib/externalAssets.ts). Empty = defaults.
# Example USDT row (single line):
# ASSETS_JSON=[{"assetId":"usdt","symbol":"USDT","decimals":6,"l1Decimals":6,"depositAddressMode":"per-user","custodyAddress":"0x…","contract":"0xdAC17F958D2ee523a2206206994597C13D831ec7","l1TokenId":"…","redemptionAddress":"0x…","maxSupplyRaw":"1000000000000000","maxMintRaw":"10000000000000"}]
ASSETS_JSON=

# Per-user deposit addresses (depositAddressMode="per-user"). xpub only for
# `serve`; the xprv is used exclusively by `cli sweep` with ALLOW_LIVE_SWEEP=1.
# Keep both in the HSM/MPC path where possible (L1_SIGNER/SWEEP_SIGN_COMMAND).
DEPOSIT_XPUB=
DEPOSIT_XPUB_PATH=0
DEPOSIT_XPRV=
DEPOSIT_XPRV_PATH=0
ALLOW_LIVE_SWEEP=0

# ─── Chain adapters ───
# Server-side RPC (not the public same-origin /eth proxy).
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
L1_URL=https://ordereu1.bigtangle.org
# Local key path (Testnet / small float only). Production: L1_SIGNER=command.
L1_ISSUER_KEY=
ALLOW_LIVE_L1=0
FROM_BLOCK=0

# HSM/MPC signer commands (docs/issuer-hsm-adapter.md). Empty = local keys.
L1_SIGNER=
L1_MINT_COMMAND=
SWEEP_SIGN_COMMAND=
TREASURY_RELEASE_COMMAND=
ALLOW_LIVE_TREASURY=0
SIGNER_TIMEOUT_MS=30000

# Only if the SPA calls the issuer cross-origin; /issuer/* through Caddy is
# same-origin and needs nothing here.
CORS_ORIGIN=

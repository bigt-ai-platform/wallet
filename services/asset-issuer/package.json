{
  "name": "asset-issuer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Issuer service for the four tradable L1-order assets (HKD, USD, XAU, custodial bETH): reserve ledger, operation state machine and the distributor API the wallet already speaks.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "bs58": "^6.0.0",
    "fastify": "^5.12.3",
    "pg": "^8.13.0",
    "secp256k1": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
